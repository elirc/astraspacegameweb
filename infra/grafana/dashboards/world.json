{
  "title": "Warband world health",
  "uid": "warband-world",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Event lag p50 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(warband_event_lag_seconds_bucket[2m])) by (le))",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(warband_event_lag_seconds_bucket[2m])) by (le))",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest pending event",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(warband_oldest_event_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pending events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(warband_pending_events)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Resolver transaction p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(warband_resolver_transaction_seconds_bucket[2m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "API p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(warband_http_request_seconds_bucket[2m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Committed events per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(warband_events_resolved_total[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "WebSocket connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(warband_ws_connections)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Outbox backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(warband_outbox_backlog)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Lock retry exhaustion",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(warband_lock_retry_exhaustions_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(warband_process_resident_memory_bytes)",
          "refId": "A"
        }
      ]
    }
  ]
}