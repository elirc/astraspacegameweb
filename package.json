{
  "name": "warband-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch apps/server/src/bootstrap.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && turbo run build",
    "start": "tsx apps/server/src/bootstrap.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres redis",
    "check": "npm run build && npm test",
    "admin": "tsx tools/admin.ts",
    "configure:local": "tsx tools/configure-local.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx tools/migrate.ts",
    "config:validate": "tsx tools/validate-config.ts",
    "test:load": "tsx tools/sim/load.ts",
    "test:chaos": "tsx tools/sim/chaos.ts",
    "test:recovery": "tsx tools/sim/recovery.ts",
    "lint": "eslint apps packages tools tests && node tools/check-boundaries.mjs",
    "test:containers": "tsx tools/testcontainers.ts",
    "test:redis-outage": "tsx tools/sim/redis-outage.ts",
    "replay": "tsx tools/sim/replay.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.2.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.16.3",
    "pixi.js": "^8.13.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3",
    "redis": "^5.8.0",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.9.6",
    "testcontainers": "^11.14.0",
    "tsx": "^4.20.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "dockerode": {
      "uuid": "^11.1.1"
    }
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "dockerode>uuid": "^11.1.1"
    }
  }
}
